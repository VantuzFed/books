<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Книжная полка</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <script>
  (function() {
    try {
      var p = new URLSearchParams(window.location.search);
      var t = p.get('theme') || localStorage.getItem('bookshelf_theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
      var b = p.get('bg') || localStorage.getItem('bookshelf_stalker_bg') || 'menu';
      document.documentElement.setAttribute('data-stalker-bg', b);
    } catch(e) {}
  })();
</script>
</head>
  <body>
    <div id="app"></div>
    <script type="module" src="/src/main.js"></script>
  </body>
</html>
